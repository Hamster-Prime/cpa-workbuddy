+func TestHostExecutorSelectsNativeFormatPerResolvedModel(t *testing.T) {
+	client := sdktranslator.Format("native-selection-client")
+	first := sdktranslator.Format("native-selection-first")
+	second := sdktranslator.Format("native-selection-second")
+	for _, native := range []sdktranslator.Format{first, second} {
+		registerNativeFormatTestPair(t, client, native, sdktranslator.ResponseTransform{
+			NonStream: func(context.Context, string, []byte, []byte, []byte, *any) []byte {
+				return []byte(`{"client_response":"translated"}`)
+			},
+		})
+	}
+	var received []pluginapi.ExecutorRequest
+	host := nativeFormatTestHost(t, "native-selection-provider", []pluginapi.ModelInfo{
+		{ID: "prefix/opaque-a", NativeFormat: first.String()},
+		{ID: "prefix/opaque-b", NativeFormat: second.String()},
+	}, &fakeExecutor{execute: func(_ context.Context, req pluginapi.ExecutorRequest) (pluginapi.ExecutorResponse, error) {
+		received = append(received, req)
+		return pluginapi.ExecutorResponse{Payload: []byte(`{"native_response":true}`)}, nil
+	}}, []string{client.String(), first.String(), second.String()}, []string{client.String(), first.String(), second.String()})
+
+	for i, model := range []string{"prefix/opaque-a", "prefix/opaque-b"} {
+		wantFormat := []sdktranslator.Format{first, second}[i]
+		body := []byte(`{"model":"client-alias","messages":[]}`)
+		req := coreexecutor.Request{Model: model, Format: client, Payload: body}
+		opts := coreexecutor.Options{SourceFormat: client, ResponseFormat: client}
+		if got := host.PluginExecutorRequestToFormat("native-selection-provider", req, opts); got != wantFormat {
+			t.Fatalf("RequestToFormat(%q) = %q, want %q", model, got, wantFormat)
+		}
+		resp, err := host.ExecutePluginExecutor(context.Background(), "native-selection-provider", req, opts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(resp.Payload) != `{"client_response":"translated"}` {
+			t.Fatalf("client response = %s", resp.Payload)
+		}
+		got := received[i]
+		if got.Model != model || got.Format != wantFormat.String() || got.SourceFormat != wantFormat.String() {
+			t.Fatalf("plugin request = %#v, want resolved model %q and native format %q", got, model, wantFormat)
+		}
+		if !bytes.Contains(got.Payload, []byte(`"native_model":"`+model+`"`)) || !bytes.Equal(got.OriginalRequest, body) {
+			t.Fatalf("translated request lost resolved model or original client payload: %#v", got)
+		}
+	}
+	info := registry.GetGlobalRegistry().GetModelInfoForProvider("prefix/opaque-a", "native-selection-provider")
+	if info == nil || info.NativeFormat != first.String() {
+		t.Fatalf("registered native metadata = %#v", info)
+	}
+	encoded, err := json.Marshal(info)
+	if err != nil || bytes.Contains(encoded, []byte("NativeFormat")) || bytes.Contains(encoded, []byte("native_format")) || bytes.Contains(encoded, []byte(first)) {
+		t.Fatalf("internal native metadata leaked into model JSON: %s (%v)", encoded, err)
+	}
+}
