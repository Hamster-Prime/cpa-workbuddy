+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+const proofHTTPBodyLimit = 32 * 1024 * 1024
+
+// Generate bytes on demand so the fixture cannot conceal an unbounded read by
+// presenting an already buffered giant response.
+type bodyLimitGeneratedReader struct {
+	remaining int64
+	read      atomic.Int64
+	closes    atomic.Int32
+	closed    chan struct{}
+}
+
+func (r *bodyLimitGeneratedReader) Read(p []byte) (int, error) {
+	if r.remaining == 0 {
+		return 0, io.EOF
+	}
+	n := len(p)
+	if int64(n) > r.remaining {
+		n = int(r.remaining)
+	}
+	for i := range p[:n] {
+		p[i] = 'x'
+	}
+	r.remaining -= int64(n)
+	r.read.Add(int64(n))
+	return n, nil
+}
+
+func (r *bodyLimitGeneratedReader) Close() error {
+	if r.closes.Add(1) == 1 && r.closed != nil {
+		close(r.closed)
+	}
+	return nil
+}
+
+type bodyLimitTransport struct {
+	calls atomic.Int32
+	do    func(*http.Request) (*http.Response, error)
+}
+
+func (r *bodyLimitTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	r.calls.Add(1)
+	return r.do(req)
+}
+
+// Only the native library is replaced: public Host executor dispatch opens the
+// callback scope and the test plugin uses the actual native HTTP callback ABI.
+type bodyLimitNativePlugin struct {
+	host      *Host
+	operation func(context.Context, pluginapi.HostHTTPClient) error
+}
+
+func (p *bodyLimitNativePlugin) Call(ctx context.Context, method string, raw []byte) ([]byte, error) {
+	if method == pluginabi.MethodExecutorIdentifier {
+		return []byte(`{"ok":true,"result":{"identifier":"http-body-contract"}}`), nil
+	}
+	if method != pluginabi.MethodExecutorExecute {
+		return nil, fmt.Errorf("unexpected plugin method %s", method)
+	}
+	var request struct {
+		CallbackID string `json:"host_callback_id"`
+	}
+	if err := json.Unmarshal(raw, &request); err != nil {
+		return nil, err
+	}
+	if request.CallbackID == "" {
+		return nil, errors.New("Host omitted native executor callback scope")
+	}
+	client := bodyLimitNativeHTTPClient{host: p.host, callbackID: request.CallbackID}
+	if err := p.operation(ctx, client); err != nil {
+		return nil, err
+	}
+	result, err := json.Marshal(pluginapi.ExecutorResponse{Payload: []byte(`{"ok":true}`)})
+	if err != nil {
+		return nil, err
+	}
+	return json.Marshal(pluginabi.Envelope{OK: true, Result: result})
+}
+
+func (*bodyLimitNativePlugin) Shutdown() {}
+
+type bodyLimitNativeHTTPClient struct {
+	host       *Host
+	callbackID string
+}
+
+func (c bodyLimitNativeHTTPClient) call(ctx context.Context, method string, request any, result any) error {
+	raw, err := json.Marshal(request)
+	if err != nil {
+		return err
+	}
+	raw, err = c.host.callFromPlugin(ctx, method, raw)
+	if err != nil {
+		return err
+	}
+	var envelope pluginabi.Envelope
+	if err := json.Unmarshal(raw, &envelope); err != nil {
+		return err
+	}
+	if !envelope.OK {
+		if envelope.Error != nil {
+			return envelope.Error
+		}
+		return errors.New("native callback failed without error metadata")
+	}
+	return json.Unmarshal(envelope.Result, result)
+}
+
+func (c bodyLimitNativeHTTPClient) Do(_ context.Context, request pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	var result pluginapi.HTTPResponse
+	err := c.call(context.Background(), pluginabi.MethodHostHTTPDo, struct {
+		pluginapi.HTTPRequest
+		CallbackID string `json:"host_callback_id"`
+	}{request, c.callbackID}, &result)
+	return result, err
+}
+
+func (c bodyLimitNativeHTTPClient) DoStream(ctx context.Context, request pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	var result struct {
+		StatusCode int         `json:"status_code"`
+		Headers    http.Header `json:"headers"`
+		StreamID   string      `json:"stream_id"`
+	}
+	if err := c.call(context.Background(), pluginabi.MethodHostHTTPDoStream, struct {
+		pluginapi.HTTPRequest
+		CallbackID string `json:"host_callback_id"`
+	}{request, c.callbackID}, &result); err != nil {
+		return pluginapi.HTTPStreamResponse{}, err
+	}
+	if result.StreamID == "" {
+		return pluginapi.HTTPStreamResponse{}, errors.New("native stream callback omitted stream ID")
+	}
+	streamRequest := struct {
+		StreamID string `json:"stream_id"`
+	}{result.StreamID}
+	chunks := make(chan pluginapi.HTTPStreamChunk)
+	go func() {
+		defer close(chunks)
+		defer func() {
+			var closed struct{}
+			_ = c.call(context.Background(), pluginabi.MethodHostHTTPStreamClose, streamRequest, &closed)
+		}()
+		for {
+			var read struct {
+				Payload []byte `json:"payload"`
+				Error   string `json:"error"`
+				Done    bool   `json:"done"`
+			}
+			err := c.call(ctx, pluginabi.MethodHostHTTPStreamRead, streamRequest, &read)
+			if err == nil && read.Error != "" {
+				err = errors.New(read.Error)
+			}
+			if len(read.Payload) != 0 || err != nil {
+				select {
+				case chunks <- pluginapi.HTTPStreamChunk{Payload: read.Payload, Err: err}:
+				case <-ctx.Done():
+					return
+				}
+			}
+			if err != nil || read.Done {
+				return
+			}
+		}
+	}()
+	return pluginapi.HTTPStreamResponse{StatusCode: result.StatusCode, Headers: result.Headers, Chunks: chunks}, nil
+}
+
+func bodyLimitExecute(ctx context.Context, transport http.RoundTripper, operation func(context.Context, pluginapi.HostHTTPClient) error) error {
+	plugin := &bodyLimitNativePlugin{operation: operation}
+	adapter := &rpcPluginAdapter{id: "http-body-contract", client: plugin}
+	host := newHostWithRecords(capabilityRecord{
+		id: "http-body-contract",
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{
+			Executor:              rpcProviderExecutor{rpcPluginAdapter: adapter},
+			ExecutorInputFormats:  []string{"openai"},
+			ExecutorOutputFormats: []string{"openai"},
+		}},
+	})
+	adapter.host = host
+	plugin.host = host
+	ctx = context.WithValue(ctx, "cliproxy.roundtripper", transport)
+	_, err := host.ExecutePluginExecutor(ctx, "http-body-contract",
+		coreexecutor.Request{Model: "body-model", Format: sdktranslator.FormatOpenAI, Payload: []byte(`{"messages":[]}`)},
+		coreexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI, ResponseFormat: sdktranslator.FormatOpenAI})
+	return err
+}
