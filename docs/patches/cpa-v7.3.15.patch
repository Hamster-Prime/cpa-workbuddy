+func TestManagerPluginAutoRefreshDuePlanReachesExecutorAndKeepsNextPlan(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	now := time.Now()
+	nextPlan := now.Add(24 * time.Hour)
+	var calls atomic.Int32
+	host := newHostWithRecords(capabilityRecord{
+		id: "schedule-plugin",
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{
+			Executor: &fakeExecutor{identifier: "unlisted-scheduled-provider"},
+			AuthProvider: fakeAuthProvider{
+				identifier: "unlisted-scheduled-provider",
+				refreshAuth: func(context.Context, pluginapi.AuthRefreshRequest) (pluginapi.AuthRefreshResponse, error) {
+					calls.Add(1)
+					return pluginapi.AuthRefreshResponse{
+						Auth:             pluginapi.AuthData{Metadata: map[string]any{"access_token": "renewed"}},
+						NextRefreshAfter: nextPlan,
+					}, nil
+				},
+			},
+		}},
+	})
+	hook := &refreshScheduleHook{updated: make(chan *coreauth.Auth, 8)}
+	manager := coreauth.NewManager(nil, nil, hook)
+	defer manager.StopAutoRefresh()
+	host.RegisterExecutors(manager, nil)
+	credential := host.AuthDataToCoreAuth(pluginapi.AuthData{
+		ID: "scheduled-auth", Provider: "unlisted-scheduled-provider",
+		Metadata:         map[string]any{"access_token": "old", "expires_at": now.Add(time.Hour).Format(time.RFC3339Nano)},
+		NextRefreshAfter: now.Add(-time.Minute),
+	}, "", "")
+	if _, err := manager.Register(ctx, credential); err != nil {
+		t.Fatal(err)
+	}
+	// A due plan must enter the initial heap immediately, even when the generic
+	// evaluator polling interval would otherwise postpone it for an hour.
+	manager.StartAutoRefresh(ctx, time.Hour)
+	var updated *coreauth.Auth
+	select {
+	case updated = <-hook.updated:
+	case <-time.After(3 * time.Second):
+		t.Fatal("due plugin plan did not reach the real executor through auto-refresh")
+	}
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("plugin refresh calls = %d, want 1", got)
+	}
+	if updated.Metadata["access_token"] != "renewed" || !updated.NextRefreshAfter.Equal(nextPlan) {
+		t.Fatalf("refreshed auth = %#v, want renewed token and returned next plan", updated)
+	}
+	evaluator, ok := updated.Runtime.(coreauth.RefreshEvaluator)
+	if !ok {
+		t.Fatal("successful refresh lost the plugin refresh evaluator")
+	}
+	if evaluator.ShouldRefresh(nextPlan.Add(-time.Nanosecond), updated) {
+		t.Fatal("successful refresh is immediately due instead of waiting for its next plan")
+	}
+	if !evaluator.ShouldRefresh(nextPlan, updated) {
+		t.Fatal("successful refresh did not follow its next plan")
+	}
+}
