+package auth
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type scheduledRefreshEvaluator struct {
+	next time.Time
+}
+
+func (e scheduledRefreshEvaluator) ShouldRefresh(now time.Time, credential *Auth) bool {
+	return !credential.Disabled && credential.Status != StatusDisabled && !now.Before(e.next)
+}
+
+type scheduledRefreshExecutor struct {
+	schedulerProviderTestExecutor
+	calls int
+	plan  time.Time
+	err   error
+	empty bool
+}
+
+func (e *scheduledRefreshExecutor) Refresh(_ context.Context, credential *Auth) (*Auth, error) {
+	e.calls++
+	if e.err != nil {
+		return nil, e.err
+	}
+	if e.empty {
+		return nil, nil
+	}
+	if !e.plan.IsZero() {
+		credential.NextRefreshAfter = e.plan
+		credential.Runtime = scheduledRefreshEvaluator{next: e.plan}
+	}
+	return credential, nil
+}
+
+func TestManagerAutoRefreshRuntimePlanDispatch(t *testing.T) {
+	now := time.Now()
+	for _, tc := range []struct {
+		name         string
+		plan         time.Time
+		gate         time.Time
+		disabled     bool
+		status       Status
+		wantDispatch bool
+	}{
+		{name: "due_initial", plan: now.Add(-time.Minute), wantDispatch: true},
+		{name: "future", plan: now.Add(time.Hour), gate: now.Add(time.Hour)},
+		{name: "disabled", plan: now.Add(-time.Minute), disabled: true},
+		{name: "status_disabled", plan: now.Add(-time.Minute), status: StatusDisabled},
+		{name: "backoff", plan: now.Add(-time.Minute), gate: now.Add(time.Hour)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			manager := NewManager(nil, nil, nil)
+			defer manager.StopAutoRefresh()
+			executor := &scheduledRefreshExecutor{
+				schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "runtime-scheduled"},
+				plan:                          now.Add(24 * time.Hour),
+			}
+			manager.RegisterExecutor(executor)
+			credential := &Auth{
+				ID: "auth", Provider: "runtime-scheduled", Disabled: tc.disabled, Status: tc.status,
+				Runtime: scheduledRefreshEvaluator{next: tc.plan}, NextRefreshAfter: tc.gate,
+			}
+			if _, err := manager.Register(context.Background(), credential); err != nil {
+				t.Fatal(err)
+			}
+			// Drive the real scheduler at fixed instants without timers or workers.
+			loop := newAuthAutoRefreshLoop(manager, time.Hour, 1)
+			loop.rebuild(now)
+			loop.handleDue(context.Background(), now)
+			select {
+			case id := <-loop.jobs:
+				if !tc.wantDispatch {
+					t.Fatal("scheduler dispatched a waiting or disabled credential")
+				}
+				if _, err := manager.ForceRefreshAuth(context.Background(), id); err != nil {
+					t.Fatal(err)
+				}
+			default:
+				if tc.wantDispatch {
+					t.Fatal("initial due runtime plan was postponed instead of dispatched")
+				}
+			}
+			if !tc.wantDispatch {
+				if executor.calls != 0 {
+					t.Fatalf("refresh calls = %d, want zero", executor.calls)
+				}
+				return
+			}
+			if executor.calls != 1 {
+				t.Fatalf("refresh calls = %d, want 1", executor.calls)
+			}
+			updated, ok := manager.GetByID(credential.ID)
+			if !ok || !updated.NextRefreshAfter.Equal(executor.plan) {
+				t.Fatalf("successful plan = %#v, want %s", updated, executor.plan)
+			}
+			loop.rebuild(now)
+			loop.handleDue(context.Background(), now.Add(time.Hour))
+			select {
+			case <-loop.jobs:
+				t.Fatal("successful refresh looped before its returned next plan")
+			default:
+			}
+			loop.handleDue(context.Background(), executor.plan)
+			select {
+			case id := <-loop.jobs:
+				if id != credential.ID {
+					t.Fatalf("next plan dispatched %q, want %q", id, credential.ID)
+				}
+			default:
+				t.Fatal("scheduler did not follow the successful returned plan")
+			}
+		})
+	}
+}
