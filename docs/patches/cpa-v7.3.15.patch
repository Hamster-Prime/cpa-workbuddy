+func registerNativeFormatTestPair(t *testing.T, client, native sdktranslator.Format, response sdktranslator.ResponseTransform) {
+	t.Helper()
+	sdktranslator.Register(client, native, func(model string, body []byte, stream bool) []byte {
+		payload, _ := json.Marshal(map[string]any{"native_model": model, "native_stream": stream})
+		return payload
+	}, response)
+	t.Cleanup(func() { sdktranslator.Unregister(client, native) })
+}
