+func nativeFormatTestHost(t *testing.T, provider string, models []pluginapi.ModelInfo, executor *fakeExecutor, inputs, outputs []string) *Host {
+	t.Helper()
+	executor.identifier = provider
+	host := newHostWithRecords(capabilityRecord{
+		id: provider,
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{
+			Executor:              executor,
+			ExecutorInputFormats:  inputs,
+			ExecutorOutputFormats: outputs,
+			ModelRegistrar: modelRegistrarFunc(func(context.Context, pluginapi.ModelRegistrationRequest) (pluginapi.ModelRegistrationResponse, error) {
+				return pluginapi.ModelRegistrationResponse{Provider: provider, Models: models}, nil
+			}),
+		}},
+	})
+	host.RegisterModels(context.Background(), registry.GetGlobalRegistry())
+	host.RegisterExecutors(newFakeExecutorManager(), registry.GetGlobalRegistry())
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(pluginExecutorModelClientID(provider, provider)) })
+	return host
+}
