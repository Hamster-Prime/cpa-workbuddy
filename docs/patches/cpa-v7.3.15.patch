+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+const permanentCredentialStateJSON = `{"version":1,"status":"reauth_required","reason":"invalid_grant","credential_digest":"a87612054c29f741b75d151dc1fbd63567a9e3bb002f5ccf22e9af48f9e88f31"}`
+
+func lifecycleCredential(t *testing.T, state string) *Auth {
+	t.Helper()
+	metadata := map[string]any{
+		"access_token": "access-a", "refresh_token": "refresh-a",
+		"expires_at": time.Now().Add(time.Hour).Format(time.RFC3339Nano),
+	}
+	if state != "" {
+		var value any
+		if err := json.Unmarshal([]byte(state), &value); err != nil {
+			t.Fatal(err)
+		}
+		metadata["credential_state"] = value
+	}
+	return &Auth{ID: "permanent-account", Provider: "state-provider", Status: StatusActive, Metadata: metadata, NextRefreshAfter: time.Now().Add(time.Hour)}
+}
+
+func assertPermanentCredential(t *testing.T, auth *Auth) {
+	t.Helper()
+	if auth == nil || auth.Status != StatusError || !auth.Unavailable || auth.LastError == nil || auth.LastError.Code != "reauth_required" || auth.LastError.HTTPStatus != http.StatusUnauthorized || !auth.NextRefreshAfter.IsZero() {
+		t.Fatalf("expected permanent credential failure, got %#v", auth)
+	}
+}
+
+func TestManagerCredentialStateLoadValidatesBindingAndContract(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		state        string
+		changeTokens bool
+		blocked      bool
+	}{
+		{name: "bound state", state: permanentCredentialStateJSON, blocked: true},
+		{name: "invalid token", state: strings.Replace(permanentCredentialStateJSON, "invalid_grant", "invalid_token", 1), blocked: true},
+		{name: "revoked", state: strings.Replace(permanentCredentialStateJSON, "invalid_grant", "revoked", 1), blocked: true},
+		{name: "new tokens", state: permanentCredentialStateJSON, changeTokens: true},
+		{name: "wrong version", state: strings.Replace(permanentCredentialStateJSON, `"version":1`, `"version":2`, 1)},
+		{name: "fractional version", state: strings.Replace(permanentCredentialStateJSON, `"version":1`, `"version":1.5`, 1)},
+		{name: "wrong status", state: strings.Replace(permanentCredentialStateJSON, "reauth_required", "healthy", 1)},
+		{name: "unknown reason", state: strings.Replace(permanentCredentialStateJSON, "invalid_grant", "temporary", 1)},
+		{name: "wrong digest", state: strings.Replace(permanentCredentialStateJSON, "a8761205", "00000000", 1)},
+		{name: "malformed state", state: `"invalid_grant"`},
+		{name: "explicit healthy", state: "null"},
+		{name: "unrelated provider has no contract"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			store := newMemoryAuthTestStore()
+			auth := lifecycleCredential(t, tc.state)
+			if tc.changeTokens {
+				auth.Metadata["access_token"] = "access-b"
+			}
+			if _, err := store.Save(ctx, auth); err != nil {
+				t.Fatal(err)
+			}
+			manager := NewManager(store, nil, nil)
+			if err := manager.Load(ctx); err != nil {
+				t.Fatal(err)
+			}
+			loaded, ok := manager.GetByID(auth.ID)
+			if !ok {
+				t.Fatal("Load omitted credential")
+			}
+			if tc.blocked {
+				assertPermanentCredential(t, loaded)
+			} else if loaded.LastError != nil || loaded.Unavailable || loaded.Status != StatusActive || !loaded.NextRefreshAfter.Equal(auth.NextRefreshAfter) {
+				t.Fatal("invalid or absent credential state changed runtime behavior")
+			}
+		})
+	}
+}
+
+type credentialLifecycleExecutor struct {
+	schedulerProviderTestExecutor
+	refresh func(context.Context, *Auth) (*Auth, error)
+}
+
+func (executor credentialLifecycleExecutor) Refresh(ctx context.Context, auth *Auth) (*Auth, error) {
+	return executor.refresh(ctx, auth)
+}
+
+func TestManagerCredentialStateRefreshFailureCannotReinstateBackoff(t *testing.T) {
+	ctx := context.Background()
+	manager := NewManager(nil, nil, nil)
+	calls := 0
+	refreshFailure := errors.New("provider returned permanent refresh failure")
+	manager.RegisterExecutor(credentialLifecycleExecutor{
+		schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "state-provider"},
+		refresh: func(ctx context.Context, _ *Auth) (*Auth, error) {
+			calls++
+			current, _ := manager.GetByID("permanent-account")
+			terminal := lifecycleCredential(t, permanentCredentialStateJSON)
+			current.Metadata["credential_state"] = terminal.Metadata["credential_state"]
+			if _, err := manager.Update(WithSkipPersist(ctx), current); err != nil {
+				t.Fatal(err)
+			}
+			return nil, refreshFailure
+		},
+	})
+	if _, err := manager.Register(ctx, lifecycleCredential(t, "null")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := manager.ForceRefreshAuth(ctx, "permanent-account"); !errors.Is(err, refreshFailure) {
+		t.Fatalf("force refresh error = %v", err)
+	}
+	current, _ := manager.GetByID("permanent-account")
+	assertPermanentCredential(t, current)
+	if _, err := manager.ForceRefreshAuth(ctx, "permanent-account"); err == nil {
+		t.Fatal("forced refresh accepted a persisted permanent failure")
+	}
+	if calls != 1 {
+		t.Fatalf("refresh calls = %d, want one before the state was persisted", calls)
+	}
+}
+
+func TestManagerCredentialStateConcurrentRefreshSuccessKeepsTerminalState(t *testing.T) {
+	ctx := context.Background()
+	store := newMemoryAuthTestStore()
+	manager := NewManager(store, nil, nil)
+	manager.RegisterExecutor(credentialLifecycleExecutor{
+		schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "state-provider"},
+		refresh: func(ctx context.Context, auth *Auth) (*Auth, error) {
+			current, _ := manager.GetByID(auth.ID)
+			terminal := lifecycleCredential(t, permanentCredentialStateJSON)
+			current.Metadata["credential_state"] = terminal.Metadata["credential_state"]
+			if _, err := manager.Update(ctx, current); err != nil {
+				t.Fatal(err)
+			}
+			return auth, nil
+		},
+	})
+	if _, err := manager.Register(ctx, lifecycleCredential(t, "null")); err != nil {
+		t.Fatal(err)
+	}
+	saved, err := manager.ForceRefreshAuth(ctx, "permanent-account")
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertPermanentCredential(t, saved)
+	current, _ := manager.GetByID("permanent-account")
+	assertPermanentCredential(t, current)
+	restarted := NewManager(store, nil, nil)
+	if err := restarted.Load(ctx); err != nil {
+		t.Fatal(err)
+	}
+	current, _ = restarted.GetByID("permanent-account")
+	assertPermanentCredential(t, current)
+}
+
+func TestManagerCredentialStateReloginSurvivesStaleRefreshCompletion(t *testing.T) {
+	for _, failRefresh := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "failure"}[failRefresh], func(t *testing.T) {
+			ctx := context.Background()
+			manager := NewManager(nil, nil, nil)
+			manager.RegisterExecutor(credentialLifecycleExecutor{
+				schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "state-provider"},
+				refresh: func(ctx context.Context, auth *Auth) (*Auth, error) {
+					login := lifecycleCredential(t, "null")
+					login.Metadata["access_token"] = "access-b"
+					login.Metadata["refresh_token"] = "refresh-b"
+					if _, err := manager.Update(ctx, login); err != nil {
+						t.Fatal(err)
+					}
+					if failRefresh {
+						return nil, errors.New("stale network failure")
+					}
+					return auth, nil
+				},
+			})
+			if _, err := manager.Register(ctx, lifecycleCredential(t, "null")); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := manager.ForceRefreshAuth(ctx, "permanent-account"); err != nil {
+				t.Fatal(err)
+			}
+			current, _ := manager.GetByID("permanent-account")
+			if current.Metadata["access_token"] != "access-b" || current.Metadata["refresh_token"] != "refresh-b" || current.LastError != nil || current.Unavailable {
+				t.Fatal("stale refresh completion replaced successful login state")
+			}
+		})
+	}
