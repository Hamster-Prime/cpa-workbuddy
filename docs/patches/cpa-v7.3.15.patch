+package pluginhost
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestPluginRefreshKeepsPhysicalCredentialSource(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "account.json")
+	host := newHostWithRecords(capabilityRecord{
+		id: "source-provider",
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{
+			Executor: &fakeExecutor{identifier: "source-provider"},
+			AuthProvider: fakeAuthProvider{
+				identifier: "source-provider",
+				refreshAuth: func(context.Context, pluginapi.AuthRefreshRequest) (pluginapi.AuthRefreshResponse, error) {
+					return pluginapi.AuthRefreshResponse{Auth: pluginapi.AuthData{
+						ID: "account", Provider: "source-provider", FileName: "account.json",
+						Metadata:   map[string]any{"access_token": "fixture-rotated"},
+						Attributes: map[string]string{"scope": "enterprise", coreauth.AttributePath: "untrusted-relative-path"},
+					}}, nil
+				},
+			}}},
+	})
+	base := host.AuthDataToCoreAuth(pluginapi.AuthData{ID: "account", Provider: "source-provider", FileName: "account.json", Metadata: map[string]any{"access_token": "fixture-access"}}, path, "account.json")
+	updated, handled, err := host.RefreshAuth(context.Background(), base)
+	if err != nil || !handled || updated == nil {
+		t.Fatalf("refresh result: handled=%v error=%v", handled, err)
+	}
+	if updated.Attributes[coreauth.AttributePath] != path || updated.Attributes[coreauth.AttributeSource] != path || updated.Attributes[coreauth.AttributeSourceBackend] != coreauth.AuthSourceFile {
+		t.Fatal("refresh changed the host-owned physical credential source")
+	}
+	if updated.ID != base.ID || updated.FileName != base.FileName || updated.Attributes["scope"] != "enterprise" || updated.Metadata["access_token"] != "fixture-rotated" {
+		t.Fatal("refresh did not keep identity and returned provider material")
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	host.RegisterExecutors(manager, nil)
+	if _, err := manager.Register(context.Background(), base); err != nil {
+		t.Fatal(err)
+	}
+	viaExecutor, err := manager.ForceRefreshAuth(context.Background(), base.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if viaExecutor.Attributes[coreauth.AttributePath] != path || viaExecutor.Attributes[coreauth.AttributeSource] != path || viaExecutor.Attributes[coreauth.AttributeSourceBackend] != coreauth.AuthSourceFile {
+		t.Fatal("native executor refresh changed the physical credential source")
+	}
+}
