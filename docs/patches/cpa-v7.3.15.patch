+func TestHostExecutorNativeFormatMetadataIsProviderScoped(t *testing.T) {
+	client := sdktranslator.Format("native-scoped-client")
+	native := sdktranslator.Format("native-scoped-foreign")
+	model := "native-scoped-shared-model"
+	host := nativeFormatTestHost(t, "native-scoped-local-provider", []pluginapi.ModelInfo{{ID: model}}, &fakeExecutor{
+		execute: func(_ context.Context, req pluginapi.ExecutorRequest) (pluginapi.ExecutorResponse, error) {
+			if req.Format != client.String() || req.SourceFormat != client.String() || req.Model != model {
+				t.Fatalf("foreign model metadata affected local executor: %#v", req)
+			}
+			return pluginapi.ExecutorResponse{Payload: []byte(`{"local":true}`)}, nil
+		},
+	}, []string{client.String()}, []string{client.String()})
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient("native-scoped-foreign-client", "native-scoped-foreign-provider", []*registry.ModelInfo{{ID: model, NativeFormat: native.String()}})
+	t.Cleanup(func() { reg.UnregisterClient("native-scoped-foreign-client") })
+	if got := reg.GetModelInfoForProvider(model, "unregistered-provider"); got != nil {
+		t.Fatalf("strict provider lookup returned foreign metadata: %#v", got)
+	}
+	resp, err := host.ExecutePluginExecutor(context.Background(), "native-scoped-local-provider", coreexecutor.Request{Model: model}, coreexecutor.Options{SourceFormat: client})
+	if err != nil || string(resp.Payload) != `{"local":true}` {
+		t.Fatalf("legacy model request = %s, %v", resp.Payload, err)
+	}
+}
