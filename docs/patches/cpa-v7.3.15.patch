+func (u *claudeGeminiUsage) merge(value gjson.Result) {
+	for _, field := range [...]struct {
+		key    string
+		target *int64
+	}{{"input_tokens", &u.input}, {"output_tokens", &u.output}, {"cache_creation_input_tokens", &u.cacheCreate}, {"cache_read_input_tokens", &u.cacheRead}, {"reasoning_tokens", &u.thinking}, {"thinking_tokens", &u.thinking}} {
