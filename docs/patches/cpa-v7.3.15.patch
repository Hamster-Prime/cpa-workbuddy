+	if err == nil || len(resp.Payload) != 0 {
+		t.Fatalf("unchanged nonstream conversion succeeded: %q, %v", resp.Payload, err)
+	}
+	result, err := host.ExecutePluginExecutorStream(context.Background(), "native-unchanged-provider", req, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var streamErr error
+	for chunk := range result.Chunks {
+		if len(chunk.Payload) != 0 {
+			t.Fatalf("unchanged native frame leaked: %q", chunk.Payload)
+		}
+		if chunk.Err != nil {
+			streamErr = chunk.Err
+		}
+	}
+	if streamErr == nil {
+		t.Fatal("unchanged stream conversion succeeded without error")
+	}
+}
