+		maxRead   int64
+		wantError bool
+	}{
+		{"exact_bound", 33554432, 33554432, 33554432, false},
+		{"overflow", 134217728, 33554433, 33619968, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := &bodyLimitGeneratedReader{remaining: tc.size, closed: make(chan struct{})}
+			transport := &bodyLimitTransport{do: func(req *http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: http.StatusAccepted, Header: http.Header{"X-Body-Proof": {"response"}}, Body: body, ContentLength: -1, Request: req}, nil
+			}}
+			err := bodyLimitExecute(context.Background(), transport, func(ctx context.Context, client pluginapi.HostHTTPClient) error {
+				response, err := client.Do(ctx, pluginapi.HTTPRequest{URL: "http://body-proof.invalid/response"})
+				if tc.wantError {
+					if err == nil || !strings.Contains(err.Error(), "32 MiB") {
+						return fmt.Errorf("overflow error = %v, want body-limit diagnostic", err)
+					}
+					if len(response.Body) != 0 {
+						return fmt.Errorf("overflow exposed %d partial bytes as a successful response", len(response.Body))
+					}
+					return nil
+				}
+				if err != nil {
+					return err
+				}
+				if len(response.Body) != proofHTTPBodyLimit || response.Body[0] != 'x' || response.Body[len(response.Body)-1] != 'x' {
+					return fmt.Errorf("exact-bound response length/content = %d", len(response.Body))
+				}
+				if response.StatusCode != http.StatusAccepted || response.Headers.Get("X-Body-Proof") != "response" {
+					return fmt.Errorf("response lost status or headers: %d, %v", response.StatusCode, response.Headers)
+				}
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case <-body.closed:
+			case <-time.After(5 * time.Second):
+				t.Fatal("native HTTP response body was not closed after completion/overflow")
+			}
+			if got := body.read.Load(); got < tc.minRead || got > tc.maxRead {
+				t.Fatalf("response consumed %d bytes, want between %d and %d", got, tc.minRead, tc.maxRead)
+			}
+			if body.closes.Load() != 1 || transport.calls.Load() != 1 {
+				t.Fatalf("body closes = %d, transport calls = %d; want one each", body.closes.Load(), transport.calls.Load())
+			}
+		})
