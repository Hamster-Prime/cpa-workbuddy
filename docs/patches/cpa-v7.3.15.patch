+func TestHostAuthSavePreservesPluginIdentityAndManagement(t *testing.T) {
+	ctx := context.Background()
+	authDir := t.TempDir()
+	path := filepath.Join(authDir, "account.json")
+	host := newHostWithRecords(capabilityRecord{
+		id: "save-provider",
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: fakeAuthProvider{
+			identifier: "save-provider",
+			parseAuth: func(_ context.Context, req pluginapi.AuthParseRequest) (pluginapi.AuthParseResponse, error) {
+				if req.Path != path || req.FileName != "account.json" || req.Host.AuthDir != authDir {
+					t.Fatal("parser did not receive the save file context")
+				}
+				return pluginapi.AuthParseResponse{Handled: true, Auth: pluginapi.AuthData{
+					ID: "stable-account-id", FileName: "account.json",
+					Metadata:    map[string]any{"access_token": "refreshed-token", "disabled": false, "priority": 0, "proxy_url": "http://stale.invalid", "excluded_models": []string{"stale-model"}},
+					StorageJSON: req.RawJSON,
+					Attributes:  map[string]string{"priority": "0", "excluded_models": "stale-model"},
+				}}, nil
+			},
+		}}},
+	})
+	host.runtimeConfig = &config.Config{AuthDir: authDir}
+	manager := coreauth.NewManager(nil, nil, nil)
+	host.SetAuthManager(manager)
+	runtimeState := &struct{ Value string }{Value: "keep-runtime"}
+	created := time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)
+	lastRefresh := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	nextRefresh := time.Date(2030, 1, 2, 3, 4, 5, 0, time.UTC)
+	original := &coreauth.Auth{
+		ID: "stable-account-id", Provider: "save-provider", FileName: "account.json",
+		Disabled: true, Status: coreauth.StatusDisabled, StatusMessage: "operator-disabled",
+		ProxyURL: "http://127.0.0.1:1", Runtime: runtimeState,
+		CreatedAt: created, LastRefreshedAt: lastRefresh, NextRefreshAfter: nextRefresh,
+		Attributes: map[string]string{"priority": "7", "excluded_models": "model-a,model-b", "excluded_models_hash": "host-exclusion-hash"},
+		Metadata:   map[string]any{"disabled": true, "priority": 7, "proxy_url": "http://127.0.0.1:1", "excluded_models": []string{"model-a", "model-b"}, "access_token": "old-token", "note": "keep-note"},
+	}
+	registered, err := manager.Register(ctx, original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(`{"type":"save-provider","access_token":"old-token","disabled":false,"priority":1,"proxy_url":"http://stale.invalid","excluded_models":["disk-stale"],"disk_setting":"keep-disk-setting"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	request, err := json.Marshal(pluginapi.HostAuthSaveRequest{Name: "account.json", JSON: json.RawMessage(`{"type":"save-provider","access_token":"refreshed-token","disabled":false,"priority":0,"proxy_url":"http://stale.invalid","excluded_models":["stale-model"]}`)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rawResponse, err := host.callFromPlugin(ctx, pluginabi.MethodHostAuthSave, request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := decodeRPCEnvelope[pluginapi.HostAuthSaveResponse](rawResponse)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Name != "account.json" || response.Path != path {
+		t.Fatal("save response did not identify the persisted file")
+	}
+	if strings.Contains(string(rawResponse), "refreshed-token") || strings.Contains(string(rawResponse), "old-token") {
+		t.Fatal("save response leaked credentials")
+	}
+	auths := manager.List()
+	if len(auths) != 1 {
+		t.Fatalf("save installed %d records, want one", len(auths))
+	}
+	got := auths[0]
+	if got.ID != "stable-account-id" || got.FileName != "account.json" || got.Index != registered.Index {
+		t.Fatal("save replaced the stable plugin identity")
+	}
+	if !got.Disabled || got.Status != coreauth.StatusDisabled || got.StatusMessage != "operator-disabled" || got.ProxyURL != "http://127.0.0.1:1" {
+		t.Fatal("save replaced host disable/status/proxy state")
+	}
+	if got.Attributes["priority"] != "7" || got.Attributes["excluded_models"] != "model-a,model-b" || got.Attributes["excluded_models_hash"] != "host-exclusion-hash" {
+		t.Fatal("save replaced host routing settings")
+	}
+	if got.Runtime != runtimeState || got.CreatedAt != created || got.LastRefreshedAt != lastRefresh || got.NextRefreshAfter != nextRefresh {
+		t.Fatal("save replaced host runtime or lifecycle state")
+	}
+	if got.Metadata["access_token"] != "refreshed-token" || got.Metadata["note"] != "keep-note" {
+		t.Fatal("save did not combine refreshed credentials with host metadata")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var persisted map[string]any
+	if err := json.Unmarshal(data, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if persisted["access_token"] != "refreshed-token" || persisted["disabled"] != true || persisted["priority"] != float64(7) || persisted["proxy_url"] != "http://127.0.0.1:1" || persisted["note"] != "keep-note" || persisted["disk_setting"] != "keep-disk-setting" {
+		t.Fatal("persisted credential lost refreshed token or host management state")
+	}
+	if !reflect.DeepEqual(persisted["excluded_models"], []any{"model-a", "model-b"}) {
+		t.Fatal("persisted credential lost host model exclusions")
+	}
+	storage, ok := got.Storage.(interface{ RawJSON() []byte })
+	if !ok {
+		t.Fatal("installed plugin auth has no credential storage")
+	}
+	var stored map[string]any
+	if err := json.Unmarshal(storage.RawJSON(), &stored); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(stored, persisted) {
+		t.Fatal("installed plugin storage differs from the persisted credential")
+	}
+}
