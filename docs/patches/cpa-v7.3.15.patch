+func TestHostCredentialStateSaveRestartAndStaleCAS(t *testing.T) {
+	host, manager, path := credentialStateHost(t)
+	if err := callCredentialStateSave(host, credentialHealthyA, ""); err != nil {
+		t.Fatal(err)
+	}
+	if err := callCredentialStateSave(host, credentialPermanentA, credentialHealthyA); err != nil {
+		t.Fatal(err)
+	}
+	current, ok := manager.GetByID("stable-state-account")
+	if !ok || current.Status != coreauth.StatusError || !current.Unavailable || current.LastError == nil || current.LastError.Code != "reauth_required" || current.LastError.StatusCode() != http.StatusUnauthorized || !current.NextRefreshAfter.IsZero() {
+		t.Fatalf("permanent save did not block runtime: %#v", current)
+	}
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	generation := current.Generation
+	// Same-token success from before the failure must not erase its marker.
+	if err := callCredentialStateSave(host, credentialHealthyA, credentialHealthyA); err == nil || !strings.Contains(err.Error(), "credential generation mismatch") {
+		t.Fatalf("stale state save error = %v", err)
+	}
+	if err := callCredentialStateSave(host, credentialHealthyB, credentialHealthyA); err == nil || !strings.Contains(err.Error(), "credential generation mismatch") {
+		t.Fatalf("stale token save error = %v", err)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	current, _ = manager.GetByID("stable-state-account")
+	if string(before) != string(after) || current.Generation != generation || current.LastError.Code != "reauth_required" {
+		t.Fatal("stale CAS changed disk or manager")
+	}
+	// Reconstruct a fresh host and manager from persisted JSON, without old runtime.
+	restarted, freshManager, _ := credentialStateHost(t)
+	auth, handled, err := restarted.ParseAuth(context.Background(), pluginapi.AuthParseRequest{Provider: "state-provider", Path: path, FileName: "account.json", RawJSON: after})
+	if err != nil || !handled {
+		t.Fatalf("restart parse handled=%t error=%v", handled, err)
+	}
+	loaded, err := freshManager.Register(context.Background(), auth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.ID != "stable-state-account" || loaded.LastError == nil || loaded.LastError.Code != "reauth_required" || !loaded.Unavailable || !loaded.NextRefreshAfter.IsZero() {
+		t.Fatalf("restart lost permanent state: %#v", loaded)
+	}
