+
+// ApplyAuthModelMetadata projects persisted per-account rules and current global
+// exclusions into the routing attributes consumed by model registration.
+func ApplyAuthModelMetadata(auth *coreauth.Auth, cfg *config.Config, metadata map[string]any) {
+	if auth == nil {
+		return
+	}
+	delete(auth.Attributes, "excluded_models")
+	delete(auth.Attributes, "excluded_models_hash")
+	delete(auth.Attributes, "model_aliases")
+	coreauth.SetOAuthModelAliasesAttribute(auth, extractOAuthModelAliasesFromMetadata(metadata))
+	ApplyAuthExcludedModelsMeta(auth, cfg, extractExcludedModelsFromMetadata(metadata), "oauth")
 }
 
 // ApplyAuthExcludedModelsMeta applies excluded models metadata to an auth entry.
