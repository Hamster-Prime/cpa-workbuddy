@@ -0,0 +1,161 @@
+package pluginhost
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"reflect"
+	"testing"
+	"time"
+
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+// Only the native plugin transport is replaced. Errors are observed after the
+// public Host execution API has crossed the SDK ABI envelope boundary.
+type retryContractPluginClient struct {
+	raw    []byte
+	method string
+	calls  int
+}
+
+func (c *retryContractPluginClient) Call(_ context.Context, method string, _ []byte) ([]byte, error) {
+	if method == pluginabi.MethodExecutorIdentifier {
+		return []byte(`{"ok":true,"result":{"identifier":"retry-contract"}}`), nil
+	}
+	if method != c.method {
+		return nil, fmt.Errorf("unexpected plugin method %s", method)
+	}
+	c.calls++
+	return c.raw, nil
+}
+
+func (*retryContractPluginClient) Shutdown() {}
+
+func TestHostExecutorRetryAfterEnvelopeContract(t *testing.T) {
+	future := time.Now().UTC().Add(2 * time.Hour).Truncate(time.Second)
+	for _, tc := range []struct {
+		name  string
+		value string
+		want  *time.Duration
+		date  bool
+	}{
+		{name: "delta_zero", value: "0", want: new(time.Duration(0))},
+		{name: "delta_seven", value: "7", want: new(7 * time.Second)},
+		{name: "future_http_date", value: future.Format(http.TimeFormat), date: true},
+		{name: "absent"},
+		{name: "invalid", value: "tomorrow"},
+		{name: "negative", value: "-1"},
+		{name: "duration_overflow", value: "9223372037"},
+		{name: "integer_overflow", value: "18446744073709551616"},
+		{name: "crlf", value: "7\r\nSet-Cookie: token=secret"},
+	} {
+		for _, operation := range []struct {
+			name   string
+			method string
+		}{
+			{"execute", pluginabi.MethodExecutorExecute},
+			{"count", pluginabi.MethodExecutorCountTokens},
+			{"stream_start", pluginabi.MethodExecutorExecuteStream},
+		} {
+			t.Run(tc.name+"/"+operation.name, func(t *testing.T) {
+				for _, status := range []int{http.StatusTooManyRequests, http.StatusServiceUnavailable} {
+					envelope := pluginabi.Envelope{Error: &pluginabi.Error{
+						Code: "upstream_unavailable", Message: "upstream temporarily unavailable",
+						HTTPStatus: status, UpstreamCode: "14018", RetryAfterValue: tc.value,
+					}}
+					raw, err := json.Marshal(envelope)
+					if err != nil {
+						t.Fatal(err)
+					}
+					// Assert the SDK's exported JSON contract independently of its Go names.
+					var wire struct {
+						Error map[string]json.RawMessage `json:"error"`
+					}
+					if err := json.Unmarshal(raw, &wire); err != nil {
+						t.Fatal(err)
+					}
+					if string(wire.Error["upstream_code"]) != `"14018"` {
+						t.Fatalf("upstream_code = %s", wire.Error["upstream_code"])
+					}
+					var retryValue string
+					if value, exists := wire.Error["retry_after"]; exists {
+						if err := json.Unmarshal(value, &retryValue); err != nil {
+							t.Fatal(err)
+						}
+					}
+					if retryValue != tc.value {
+						t.Fatalf("retry_after = %q, want %q", retryValue, tc.value)
+					}
+					client := &retryContractPluginClient{raw: raw, method: operation.method}
+					adapter := &rpcPluginAdapter{id: "retry-contract", client: client}
+					host := newHostWithRecords(capabilityRecord{id: "retry-contract", plugin: pluginapi.Plugin{
+						Capabilities: pluginapi.Capabilities{Executor: rpcProviderExecutor{rpcPluginAdapter: adapter}, ExecutorInputFormats: []string{"openai"}, ExecutorOutputFormats: []string{"openai"}},
+					}})
+					adapter.host = host
+					req := coreexecutor.Request{Model: "retry-model", Format: sdktranslator.FormatOpenAI, Payload: []byte(`{"messages":[]}`)}
+					opts := coreexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI, ResponseFormat: sdktranslator.FormatOpenAI}
+					started := time.Now()
+					switch operation.name {
+					case "execute":
+						_, err = host.ExecutePluginExecutor(context.Background(), "retry-contract", req, opts)
+					case "count":
+						_, err = host.CountPluginExecutor(context.Background(), "retry-contract", req, opts)
+					case "stream_start":
+						_, err = host.ExecutePluginExecutorStream(context.Background(), "retry-contract", req, opts)
+					}
+					ended := time.Now()
+					if err == nil || err.Error() != "upstream temporarily unavailable" {
+						t.Fatalf("public execution error = %v", err)
+					}
+					var metadata interface {
+						StatusCode() int
+						RetryAfter() *time.Duration
+						Headers() http.Header
+					}
+					if !errors.As(err, &metadata) {
+						t.Fatalf("error %T lost retry/status/header contract", err)
+					}
+					if metadata.StatusCode() != status {
+						t.Fatalf("status = %d, want %d", metadata.StatusCode(), status)
+					}
+					retryStarted := time.Now()
+					got := metadata.RetryAfter()
+					retryEnded := time.Now()
+					wantHeaders := http.Header(nil)
+					if tc.date {
+						if got == nil || *got < future.Sub(retryEnded) || *got > future.Sub(retryStarted) {
+							t.Fatalf("HTTP-date delay = %v, call interval %v to %v", got, started, ended)
+						}
+						wantHeaders = http.Header{"Retry-After": {tc.value}}
+					} else if tc.want != nil {
+						if got == nil || *got != *tc.want {
+							t.Fatalf("delay = %v, want %v", got, *tc.want)
+						}
+						wantHeaders = http.Header{"Retry-After": {tc.value}}
+					} else if got != nil {
+						t.Fatalf("unsafe/absent Retry-After produced delay %v", *got)
+					}
+					if gotHeaders := metadata.Headers(); !reflect.DeepEqual(gotHeaders, wantHeaders) {
+						t.Fatalf("headers = %#v, want only %#v", gotHeaders, wantHeaders)
+					}
+					if headers := metadata.Headers(); len(headers) != 0 {
+						headers.Set("Retry-After", "999")
+						headers.Set("Set-Cookie", "token=secret")
+						if !reflect.DeepEqual(metadata.Headers(), wantHeaders) {
+							t.Fatal("consumer header mutation changed subsequent error headers")
+						}
+					}
+					if client.calls != 1 {
+						t.Fatalf("host repeated plugin execution %d times", client.calls)
+					}
+				}
