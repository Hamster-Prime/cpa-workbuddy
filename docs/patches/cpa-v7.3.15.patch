+func TestPluginFileTokenStorePersistsManualDisabledChanges(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "account.json")
+	raw := []byte(`{"type":"storage-provider","access_token":"fixture-access","refresh_token":"fixture-refresh","credential_generation":"login-one","disabled":false}`)
+	var metadata map[string]any
+	if err := json.Unmarshal(raw, &metadata); err != nil {
+		t.Fatal(err)
+	}
+	auth := New().AuthDataToCoreAuth(pluginapi.AuthData{ID: "account", Provider: "storage-provider", FileName: "account.json", StorageJSON: raw, Metadata: metadata}, path, "account.json")
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(dir)
+	if _, err := store.Save(context.Background(), auth); err != nil {
+		t.Fatal(err)
+	}
+	for _, disabled := range []bool{true, false} {
+		auth.Disabled = disabled
+		if _, err := store.Save(context.Background(), auth); err != nil {
+			t.Fatal(err)
+		}
+		persisted, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var saved map[string]any
+		if err := json.Unmarshal(persisted, &saved); err != nil {
+			t.Fatal(err)
+		}
+		if saved["disabled"] != disabled {
+			t.Fatalf("manual disabled=%v did not persist", disabled)
+		}
+	}
+}
+
+func TestPluginFileTokenStoreReloginPreservesManualDisabled(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "account.json")
+	previous := []byte(`{"type":"storage-provider","access_token":"fixture-access","refresh_token":"fixture-refresh","credential_generation":"login-one","disabled":true,"priority":7}`)
+	if err := os.WriteFile(path, previous, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	raw := []byte(`{"type":"storage-provider","access_token":"fixture-access","refresh_token":"fixture-refresh","credential_generation":"login-two","disabled":false}`)
+	var metadata map[string]any
+	if err := json.Unmarshal(raw, &metadata); err != nil {
+		t.Fatal(err)
+	}
+	auth := New().AuthDataToCoreAuth(pluginapi.AuthData{ID: "account", Provider: "storage-provider", FileName: "account.json", StorageJSON: raw, Metadata: metadata}, path, "account.json")
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(dir)
+	if _, err := store.Save(coreauth.WithAuthCreationIntent(context.Background()), auth); err != nil {
+		t.Fatal(err)
+	}
+	persisted, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved map[string]any
+	if err := json.Unmarshal(persisted, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved["disabled"] != true || saved["priority"] != float64(7) || saved["credential_generation"] != "login-two" {
+		t.Fatal("relogin changed operator settings or lost the credential generation")
+	}
+}
