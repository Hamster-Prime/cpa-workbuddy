+// executorStreamData joins SSE data fields across source chunks. Built-in
+// translators consume one data event, without the source event/id/retry fields.
+const executorTranslationBufferLimit = 32 << 20
+
+type executorStreamData struct {
+	pending []byte
+	data    []byte
+	err     error
+}
+
+func (s *executorStreamData) feed(payload []byte, final bool) [][]byte {
+	if len(s.pending)+len(s.data)+len(payload) > executorTranslationBufferLimit {
+		s.err = fmt.Errorf("plugin executor stream translation exceeded the 32 MiB buffer limit")
+		return nil
+	}
+	var events [][]byte
+	flush := func() {
+		if len(s.data) > 0 {
+			events = append(events, append([]byte("data: "), s.data[:len(s.data)-1]...))
+			s.data = nil
+		}
+	}
+	if len(s.pending) == 0 && len(s.data) == 0 && json.Valid(bytes.TrimSpace(payload)) {
+		return [][]byte{append([]byte("data: "), bytes.TrimSpace(payload)...)}
+	}
+	s.pending = append(s.pending, payload...)
+	for {
+		idx := bytes.IndexByte(s.pending, '\n')
+		if idx < 0 {
+			break
+		}
+		line := bytes.TrimSuffix(s.pending[:idx], []byte("\r"))
+		s.pending = s.pending[idx+1:]
+		if len(line) == 0 {
+			flush()
+		} else if bytes.HasPrefix(line, []byte("data:")) {
+			s.data = append(s.data, bytes.TrimPrefix(line[5:], []byte(" "))...)
+			s.data = append(s.data, '\n')
+		}
+	}
+	// Some executors emit complete data lines without the SSE blank separator.
+	if bytes.HasPrefix(s.pending, []byte("data:")) {
+		body := bytes.TrimSpace(s.pending[5:])
+		if final || (len(s.data) == 0 && (json.Valid(body) || bytes.Equal(body, []byte("[DONE]")))) {
+			s.data = append(s.data, bytes.TrimPrefix(s.pending[5:], []byte(" "))...)
+			s.data = append(s.data, '\n')
+			s.pending = nil
+			flush()
+		}
+	}
+	if final {
+		flush()
+		s.pending = nil
+	}
+	return events
+}
+
+// Chat Completions and Gemini handlers add SSE framing themselves. Claude and
+// Responses handlers consume complete native SSE frames from the executor.
+func executorClientStreamUsesJSON(format sdktranslator.Format) bool {
+	return format == sdktranslator.FormatOpenAI || format == sdktranslator.FormatGemini
+}
+
+func executorClientStreamFrames(format sdktranslator.Format, frames [][]byte) ([][]byte, error) {
+	if !executorClientStreamUsesJSON(format) {
+		return frames, nil
+	}
+	var output [][]byte
+	for _, frame := range frames {
+		body := bytes.TrimSpace(frame)
+		if bytes.HasPrefix(body, []byte("event:")) || bytes.HasPrefix(body, []byte("data:")) || bytes.HasPrefix(body, []byte(":")) {
+			var source executorStreamData
+			for _, event := range source.feed(frame, true) {
+				data := bytes.TrimSpace(bytes.TrimPrefix(event, []byte("data:")))
+				if len(data) > 0 && !bytes.Equal(data, []byte("[DONE]")) {
+					output = append(output, data)
+				}
+			}
+			if source.err != nil {
+				return nil, source.err
+			}
+		} else if len(body) > 0 && !bytes.Equal(body, []byte("[DONE]")) {
+			output = append(output, frame)
+		}
+	}
+	return output, nil
 }
 
