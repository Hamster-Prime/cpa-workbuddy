+func TestHostExecutorRejectsUnavailableNativeFormatDirectionsBeforeExecution(t *testing.T) {
+	for _, test := range []struct {
+		name              string
+		request           bool
+		streamResponse    bool
+		nonStreamResponse bool
+		stream            bool
+		declareInput      bool
+		declareOutput     bool
+	}{
+		{name: "missing request", nonStreamResponse: true, declareInput: true, declareOutput: true},
+		{name: "missing nonstream response", request: true, streamResponse: true, declareInput: true, declareOutput: true},
+		{name: "missing stream response", request: true, nonStreamResponse: true, stream: true, declareInput: true, declareOutput: true},
+		{name: "undeclared input", request: true, nonStreamResponse: true, declareOutput: true},
+		{name: "undeclared output", request: true, nonStreamResponse: true, declareInput: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			key := strings.ReplaceAll(test.name, " ", "-")
+			client := sdktranslator.Format("native-unavailable-client-" + key)
+			native := sdktranslator.Format("native-unavailable-output-" + key)
+			var request sdktranslator.RequestTransform
+			if test.request {
+				request = func(string, []byte, bool) []byte { return []byte(`{"native":true}`) }
+			}
+			response := sdktranslator.ResponseTransform{}
+			if test.streamResponse {
+				response.Stream = func(context.Context, string, []byte, []byte, []byte, *any) [][]byte { return nil }
+			}
+			if test.nonStreamResponse {
+				response.NonStream = func(context.Context, string, []byte, []byte, []byte, *any) []byte { return []byte(`{"client":true}`) }
+			}
+			sdktranslator.Register(client, native, request, response)
+			t.Cleanup(func() { sdktranslator.Unregister(client, native) })
+			inputs, outputs := []string{client.String()}, []string{client.String()}
+			if test.declareInput {
+				inputs = append(inputs, native.String())
+			}
+			if test.declareOutput {
+				outputs = append(outputs, native.String())
+			}
+			called := false
+			provider := "native-unavailable-" + key
+			host := nativeFormatTestHost(t, provider, []pluginapi.ModelInfo{{ID: key, NativeFormat: native.String()}}, &fakeExecutor{
+				execute: func(context.Context, pluginapi.ExecutorRequest) (pluginapi.ExecutorResponse, error) {
+					called = true
+					return pluginapi.ExecutorResponse{}, nil
+				},
+				executeStream: func(context.Context, pluginapi.ExecutorRequest) (pluginapi.ExecutorStreamResponse, error) {
+					called = true
+					return pluginapi.ExecutorStreamResponse{}, nil
+				},
+			}, inputs, outputs)
+			req := coreexecutor.Request{Model: key, Payload: []byte(`{"model":"alias"}`)}
+			opts := coreexecutor.Options{SourceFormat: client, Stream: test.stream}
+			if got := host.PluginExecutorRequestToFormat(provider, req, opts); got != "" {
+				t.Fatalf("RequestToFormat accepted unsupported direction: %q", got)
+			}
+			var err error
+			if test.stream {
+				_, err = host.ExecutePluginExecutorStream(context.Background(), provider, req, opts)
+			} else {
+				_, err = host.ExecutePluginExecutor(context.Background(), provider, req, opts)
+			}
+			if err == nil || called {
+				t.Fatalf("unsupported direction reached executor: called=%t error=%v", called, err)
+			}
+		})
+	}
+}
