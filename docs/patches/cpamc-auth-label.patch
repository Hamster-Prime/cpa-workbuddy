+
+const WORKBUDDY_HASH =
+  '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef';
+const WORKBUDDY_FILE = `workbuddy-${WORKBUDDY_HASH}.json`;
+
+describe('deriveAuthFileIdentity with backend labels', () => {
+  test('uses the backend label for a WorkBuddy credential', () => {
+    expect(
+      deriveAuthFileIdentity(
+        authFile({
+          name: WORKBUDDY_FILE,
+          type: 'workbuddy',
+          provider: 'workbuddy',
+          label: 'WorkBuddy · 张三',
+        })
+      )
+    ).toEqual({
+      primary: 'WorkBuddy · 张三',
+      kind: 'label',
+      secondary: `workbuddy-${WORKBUDDY_HASH}`,
+      fullName: WORKBUDDY_FILE,
+    });
+  });
+
+  test('surfaces a normalized backend label through the full parse chain', () => {
+    const response = {
+      files: [
+        {
+          name: WORKBUDDY_FILE,
+          type: 'workbuddy',
+          provider: 'workbuddy',
+          label: '  WorkBuddy · 张三  ',
+        },
+      ],
+    } as unknown as AuthFilesResponse;
+    const [file] = normalizeAuthFilesResponse(response).files;
+
+    expect(file?.label).toBe('WorkBuddy · 张三');
+    expect(deriveAuthFileIdentity(file!).primary).toBe('WorkBuddy · 张三');
+    expect(deriveAuthFileIdentity(file!).kind).toBe('label');
+  });
+
+  test('keeps email above projectId above label above the file name', () => {
+    const all = deriveAuthFileIdentity(
+      authFile({
+        name: WORKBUDDY_FILE,
+        email: 'user@example.com',
+        projectId: 'proj-1',
+        label: 'WorkBuddy · 张三',
+      })
+    );
+    expect(all.kind).toBe('email');
+    expect(all.primary).toBe('user@example.com');
+
+    const project = deriveAuthFileIdentity(
+      authFile({ name: WORKBUDDY_FILE, projectId: 'proj-1', label: 'WorkBuddy · 张三' })
+    );
+    expect(project.kind).toBe('projectId');
+    expect(project.primary).toBe('proj-1');
+  });
+
+  test('shows a label that merely repeats the provider text verbatim', () => {
+    const identity = deriveAuthFileIdentity(
+      authFile({ name: WORKBUDDY_FILE, type: 'workbuddy', label: 'WorkBuddy' })
+    );
+    expect(identity.kind).toBe('label');
+    expect(identity.primary).toBe('WorkBuddy');
+    expect(identity.fullName).toBe(WORKBUDDY_FILE);
+    expect(identity).not.toHaveProperty('email');
+    expect(identity).not.toHaveProperty('projectId');
+  });
+
+  test('treats a whitespace-only label as absent', () => {
+    const identity = deriveAuthFileIdentity(authFile({ name: WORKBUDDY_FILE, label: '   ' }));
+    expect(identity.kind).toBe('fileName');
+    expect(identity.primary).toBe(`workbuddy-${WORKBUDDY_HASH}`);
+  });
+
+  test('treats a non-string label as absent (index signature guard)', () => {
+    const identity = deriveAuthFileIdentity(
+      authFile({ name: WORKBUDDY_FILE, label: 42 as unknown as string })
+    );
+    expect(identity.kind).toBe('fileName');
+    expect(identity.primary).toBe(`workbuddy-${WORKBUDDY_HASH}`);
+  });
+
+  test('drops the secondary row when the label equals the file base name', () => {
+    const identity = deriveAuthFileIdentity(
+      authFile({ name: 'kimi-1712345678901.json', label: 'kimi-1712345678901' })
+    );
+    expect(identity.primary).toBe('kimi-1712345678901');
+    expect(identity.kind).toBe('label');
+    expect(identity.secondary).toBeNull();
+  });
+});
