+package management
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	sdkauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestPatchModelRulesReachRuntimeWithoutFileWatcher(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	dir := t.TempDir()
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(dir)
+	manager := coreauth.NewManager(store, nil, nil)
+	if _, err := manager.Register(context.Background(), &coreauth.Auth{
+		ID: "account", Provider: "model-provider", FileName: "account.json",
+		Attributes: map[string]string{coreauth.AttributePath: filepath.Join(dir, "account.json")},
+		Metadata:   map[string]any{"type": "model-provider", "access_token": "fixture-access"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: dir, OAuthExcludedModels: map[string][]string{"model-provider": {"global-model"}}}, manager)
+	var synchronized *coreauth.Auth
+	h.SetPostAuthPersistHook(func(_ context.Context, auth *coreauth.Auth) error {
+		synchronized = auth.Clone()
+		return nil
+	})
+	patch := func(body string) {
+		t.Helper()
+		synchronized = nil
+		recorder := httptest.NewRecorder()
+		ctx, _ := gin.CreateTestContext(recorder)
+		ctx.Request = httptest.NewRequest(http.MethodPatch, "/v0/management/auth-files/fields", strings.NewReader(body))
+		ctx.Request.Header.Set("Content-Type", "application/json")
+		h.PatchAuthFileFields(ctx)
+		if recorder.Code != http.StatusOK || synchronized == nil {
+			t.Fatalf("model rule update did not synchronize: HTTP %d", recorder.Code)
+		}
+	}
+	patch(`{"name":"account.json","excluded_models":["account-model"],"model_aliases":[{"name":"source-model","alias":"account-alias","fork":true}]}`)
+	if synchronized.Attributes["excluded_models"] != "account-model,global-model" || !strings.Contains(synchronized.Attributes["model_aliases"], `"alias":"account-alias"`) {
+		t.Fatal("model registration hook did not receive account exclusions and aliases")
+	}
+	patch(`{"name":"account.json","excluded_models":[],"model_aliases":[]}`)
+	if synchronized.Attributes["excluded_models"] != "global-model" || synchronized.Attributes["model_aliases"] != "" {
+		t.Fatal("cleared account rules remained in runtime or removed global exclusions")
+	}
+}
