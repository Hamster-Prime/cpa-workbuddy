+	legacy := &Auth{ID: "legacy", Provider: "unrelated", Metadata: map[string]any{"access_token": "same-access", "refresh_token": "same-refresh"}}
+	if CredentialsChanged(legacy, legacy.Clone()) {
+		t.Fatal("empty generations changed legacy credential behavior")
+	}
+	changed := legacy.Clone()
+	changed.Metadata["credential_generation"] = "login-one"
+	if !CredentialsChanged(legacy, changed) {
+		t.Fatal("first explicit login generation was ignored")
+	}
+	current := changed.Clone()
+	current.Metadata["credential_generation"] = "login-two"
+	if !CredentialsChanged(changed, current) {
+		t.Fatal("same-token completed login was not a credential change")
+	}
+	if CredentialsChanged(current, current.Clone()) {
+		t.Fatal("same current generation was not stable")
+	}
+	target := changed.Clone()
+	MergeExistingAuthMetadata(target, current.Metadata)
+	if target.Metadata["credential_generation"] != "login-one" {
+		t.Fatal("management merge overwrote incoming credential generation")
+	}
+}
