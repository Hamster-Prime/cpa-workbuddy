+func TestHostExecutorTranslatesCompleteAndSplitNativeSSEEvents(t *testing.T) {
+	client := sdktranslator.Format("native-sse-client")
+	native := sdktranslator.Format("native-sse-output")
+	var received []string
+	registerNativeFormatTestPair(t, client, native, sdktranslator.ResponseTransform{
+		Stream: func(_ context.Context, _ string, _, _, body []byte, _ *any) [][]byte {
+			received = append(received, string(body))
+			return [][]byte{[]byte(`{"translated":true}`)}
+		},
+	})
+	chunks := make(chan pluginapi.ExecutorStreamChunk, 3)
+	chunks <- pluginapi.ExecutorStreamChunk{Payload: []byte("event: source\r\nid: 12\r\ndata: {\r\ndata: \"n\":1}\r\n\r\nevent: source\ndata: {\"n\":2}\n\n")}
+	chunks <- pluginapi.ExecutorStreamChunk{Payload: []byte("event: source\ndata: {\"n\":")}
+	chunks <- pluginapi.ExecutorStreamChunk{Payload: []byte("3}\n\n")}
+	close(chunks)
+	host := nativeFormatTestHost(t, "native-sse-provider", []pluginapi.ModelInfo{{ID: "native-sse-model", NativeFormat: native.String()}}, &fakeExecutor{
+		executeStream: func(_ context.Context, req pluginapi.ExecutorRequest) (pluginapi.ExecutorStreamResponse, error) {
+			if !req.Stream || req.Format != native.String() || req.SourceFormat != native.String() || !bytes.Contains(req.Payload, []byte(`"native_stream":true`)) {
+				t.Fatalf("stream request not native: %#v", req)
+			}
+			return pluginapi.ExecutorStreamResponse{Chunks: chunks}, nil
+		},
+	}, []string{client.String(), native.String()}, []string{client.String(), native.String()})
+	result, err := host.ExecutePluginExecutorStream(context.Background(), "native-sse-provider", coreexecutor.Request{Model: "native-sse-model", Payload: []byte(`{"stream":true}`)}, coreexecutor.Options{SourceFormat: client})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var output strings.Builder
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		output.Write(chunk.Payload)
+	}
+	wantInput := []string{"data: {\n\"n\":1}", `data: {"n":2}`, `data: {"n":3}`}
+	if len(received) != len(wantInput) {
+		t.Fatalf("translator calls = %#v", received)
+	}
+	for i := range wantInput {
+		if received[i] != wantInput[i] {
+			t.Fatalf("translator event %d = %q, want %q", i, received[i], wantInput[i])
+		}
+	}
+	if got, want := output.String(), strings.Repeat(`{"translated":true}`, 3); got != want {
+		t.Fatalf("translated client chunks = %q, want %q", got, want)
+	}
+}
