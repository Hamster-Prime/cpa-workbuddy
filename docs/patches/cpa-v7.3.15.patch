+type bodyLimitGatedStream struct {
+	ctx     context.Context
+	release <-chan struct{}
+	step    int
+	closes  atomic.Int32
+	closed  chan struct{}
+}
+
+func (r *bodyLimitGatedStream) Read(p []byte) (int, error) {
+	switch r.step {
+	case 0:
+		r.step++
+		return copy(p, "first"), nil
+	case 1:
+		select {
+		case <-r.ctx.Done():
+			return 0, r.ctx.Err()
+		case <-r.release:
+			r.step++
+			return copy(p, "second"), nil
+		}
+	default:
+		return 0, io.EOF
+	}
+}
+
+func (r *bodyLimitGatedStream) Close() error {
+	if r.closes.Add(1) == 1 {
+		close(r.closed)
+	}
+	return nil
+}
