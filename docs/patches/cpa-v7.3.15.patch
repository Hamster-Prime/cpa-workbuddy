+func TestManagerRuntimePlanFailureAndCancellationKeepManagerGates(t *testing.T) {
+	for _, canceled := range []bool{false, true} {
+		name := "failure_backoff"
+		refreshErr := errors.New("temporary refresh failure")
+		if canceled {
+			name = "canceled"
+			refreshErr = context.Canceled
+		}
+		t.Run(name, func(t *testing.T) {
+			manager := NewManager(nil, nil, nil)
+			defer manager.StopAutoRefresh()
+			executor := &scheduledRefreshExecutor{
+				schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "runtime-scheduled"}, err: refreshErr,
+			}
+			manager.RegisterExecutor(executor)
+			now := time.Now()
+			gate := now.Add(time.Minute)
+			if _, err := manager.Register(context.Background(), &Auth{
+				ID: "auth", Provider: "runtime-scheduled", NextRefreshAfter: gate,
+				Runtime: scheduledRefreshEvaluator{next: now.Add(-time.Hour)},
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := manager.ForceRefreshAuth(context.Background(), "auth"); !errors.Is(err, refreshErr) {
+				t.Fatalf("refresh error = %v, want %v", err, refreshErr)
+			}
+			current, ok := manager.GetByID("auth")
+			if !ok {
+				t.Fatal("credential disappeared after refresh error")
+			}
+			if canceled {
+				if !current.NextRefreshAfter.Equal(gate) || current.LastError != nil {
+					t.Fatalf("cancellation mutated manager gate or error: %#v", current)
+				}
+				return
+			}
+			if current.LastError == nil || !current.NextRefreshAfter.After(gate) {
+				t.Fatalf("failed refresh lost manager backoff: %#v", current)
+			}
+			loop := newAuthAutoRefreshLoop(manager, time.Hour, 1)
+			loop.rebuild(now)
+			loop.handleDue(context.Background(), now)
+			select {
+			case <-loop.jobs:
+				t.Fatal("failure backoff allowed immediate redispatch")
+			default:
+			}
+		})
+	}
+}
