+func (u claudeGeminiUsage) json() []byte {
+	value := []byte(`{"trafficType":"PROVISIONED_THROUGHPUT"}`)
+	prompt := u.input + u.cacheCreate + u.cacheRead
+	value, _ = sjson.SetBytes(value, "promptTokenCount", prompt)
+	value, _ = sjson.SetBytes(value, "candidatesTokenCount", u.output)
+	value, _ = sjson.SetBytes(value, "totalTokenCount", prompt+u.output)
+	if cached := u.cacheCreate + u.cacheRead; cached > 0 {
+		value, _ = sjson.SetBytes(value, "cachedContentTokenCount", cached)
+	}
+	if u.thinking > 0 {
