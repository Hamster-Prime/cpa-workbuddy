+package pluginhost
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// ApplyModelAuthUpdate installs metadata discovered by a plugin. Persistent
+// credentials use the atomic save contract even when discovery began in a file
+// watcher context; the returned data came from the network, not the watched file.
+func (h *Host) ApplyModelAuthUpdate(ctx context.Context, base, updated *coreauth.Auth) (*coreauth.Auth, error) {
+	manager := h.currentAuthManager()
+	if manager == nil {
+		return nil, fmt.Errorf("core auth manager unavailable")
+	}
+	if base == nil || updated == nil || base.ID == "" || updated.ID != base.ID || updated.Provider != base.Provider {
+		return nil, fmt.Errorf("model auth update identity differs")
+	}
+	if ctx != nil && ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if base.Storage == nil || coreauth.IsPluginVirtualAuth(base) || strings.EqualFold(strings.TrimSpace(authAttribute(base, "runtime_only")), "true") {
+		return manager.Update(ctx, updated)
+	}
+	if isUnsafeAuthFileName(base.FileName) || !strings.HasSuffix(strings.ToLower(base.FileName), ".json") {
+		return nil, fmt.Errorf("model auth update requires a safe credential filename")
+	}
+	expected, err := modelAuthJSON(base)
+	if err != nil {
+		return nil, fmt.Errorf("encode expected model credentials: %w", err)
+	}
+	data, err := modelAuthJSON(updated)
+	if err != nil {
+		return nil, fmt.Errorf("encode discovered model credentials: %w", err)
+	}
+	// A refresh during discovery may already have installed the returned tokens.
+	// CAS still compares the credential state against the physical file.
+	if coreauth.CredentialsChanged(base, updated) {
+		if current, ok := manager.GetByID(base.ID); ok && !coreauth.CredentialsChanged(current, updated) {
+			expected = data
+		}
+	}
+	if _, err := h.saveAuthFile(ctx, base.FileName, data, expected); err != nil {
+		return nil, fmt.Errorf("persist model auth update: %w", err)
+	}
+	installed, ok := manager.GetByID(base.ID)
+	if !ok || installed == nil {
+		return nil, fmt.Errorf("persisted model auth update is no longer registered")
+	}
+	return installed, nil
+}
+
+func modelAuthJSON(auth *coreauth.Auth) ([]byte, error) {
+	var raw []byte
+	if source, ok := auth.Storage.(interface{ RawJSON() []byte }); ok {
+		raw = source.RawJSON()
+	}
+	return mergedStorageJSON(raw, auth.Metadata, auth.Provider)
+}
