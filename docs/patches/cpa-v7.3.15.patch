+func TestHostExecutorRejectsUnchangedNativeResponseTranslation(t *testing.T) {
+	client := sdktranslator.Format("native-unchanged-client")
+	native := sdktranslator.Format("native-unchanged-output")
+	registerNativeFormatTestPair(t, client, native, sdktranslator.ResponseTransform{
+		NonStream: func(_ context.Context, _ string, _, _, body []byte, _ *any) []byte { return body },
+		Stream:    func(_ context.Context, _ string, _, _, body []byte, _ *any) [][]byte { return [][]byte{body} },
+	})
+	host := nativeFormatTestHost(t, "native-unchanged-provider", []pluginapi.ModelInfo{{ID: "native-unchanged-model", NativeFormat: native.String()}}, &fakeExecutor{
+		execute: func(context.Context, pluginapi.ExecutorRequest) (pluginapi.ExecutorResponse, error) {
+			return pluginapi.ExecutorResponse{Payload: []byte(`{"wrong_protocol":true}`)}, nil
+		},
+		executeStream: func(context.Context, pluginapi.ExecutorRequest) (pluginapi.ExecutorStreamResponse, error) {
+			chunks := make(chan pluginapi.ExecutorStreamChunk, 1)
+			chunks <- pluginapi.ExecutorStreamChunk{Payload: []byte("data: {\"wrong_protocol\":true}\n\n")}
+			close(chunks)
+			return pluginapi.ExecutorStreamResponse{Chunks: chunks}, nil
+		},
+	}, []string{native.String()}, []string{native.String()})
+	req := coreexecutor.Request{Model: "native-unchanged-model"}
+	opts := coreexecutor.Options{SourceFormat: client}
