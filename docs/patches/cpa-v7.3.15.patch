+func modelUpdateFixture(t *testing.T) (*Host, *coreauth.Auth, string) {
+	t.Helper()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "account.json")
+	host := newHostWithRecords(capabilityRecord{
+		id: "model-provider",
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: fakeAuthProvider{
+			identifier: "model-provider",
+			parseAuth: func(_ context.Context, req pluginapi.AuthParseRequest) (pluginapi.AuthParseResponse, error) {
+				var metadata map[string]any
+				if err := json.Unmarshal(req.RawJSON, &metadata); err != nil {
+					return pluginapi.AuthParseResponse{}, err
+				}
+				return pluginapi.AuthParseResponse{Handled: true, Auth: pluginapi.AuthData{
+					ID: "model-account", Provider: "model-provider", FileName: "account.json",
+					StorageJSON: req.RawJSON, Metadata: metadata,
+				}}, nil
+			},
+		}}},
+	})
+	host.runtimeConfig = &config.Config{AuthDir: dir}
+	manager := coreauth.NewManager(nil, nil, nil)
+	host.SetAuthManager(manager)
+	raw := []byte(`{"type":"model-provider","provider":"model-provider","access_token":"fixture-access","refresh_token":"fixture-refresh","credential_generation":"login-one","credential_state":null,"disabled":true,"priority":7}`)
+	if err := os.WriteFile(path, raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	base, handled, err := host.ParseAuth(context.Background(), pluginapi.AuthParseRequest{Provider: "model-provider", Path: path, FileName: "account.json", RawJSON: raw})
+	if err != nil || !handled || base == nil {
+		t.Fatalf("parse own fixture credential: handled=%v err=%v", handled, err)
+	}
+	registered, err := manager.Register(coreauth.WithSkipPersist(context.Background()), base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return host, registered, path
+}
+
+func TestModelAuthUpdatePersistsDiscoveredMetadataFromWatcher(t *testing.T) {
+	host, base, path := modelUpdateFixture(t)
+	updated := base.Clone()
+	updated.Metadata["model_snapshot"] = map[string]any{"site": "fixture-site", "models": []any{"account-model"}}
+	installed, err := host.ApplyModelAuthUpdate(coreauth.WithSkipPersist(context.Background()), base, updated)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var persisted map[string]any
+	if err := json.Unmarshal(raw, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{"site": "fixture-site", "models": []any{"account-model"}}
+	if !reflect.DeepEqual(persisted["model_snapshot"], want) || !reflect.DeepEqual(installed.Metadata["model_snapshot"], want) {
+		t.Fatal("discovered account metadata was not installed and persisted")
+	}
+	if persisted["disabled"] != true || persisted["priority"] != float64(7) {
+		t.Fatal("model discovery changed operator settings")
+	}
+}
+
+func TestModelAuthUpdateRejectsObsoleteCredentialGeneration(t *testing.T) {
+	host, base, path := modelUpdateFixture(t)
+	login := base.Clone()
+	login.Metadata["access_token"] = "fixture-login-access"
+	login.Metadata["credential_generation"] = "login-two"
+	if _, err := host.ApplyModelAuthUpdate(context.Background(), base, login); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	late := base.Clone()
+	late.Metadata["model_snapshot"] = map[string]any{"models": []any{"obsolete-model"}}
+	if _, err := host.ApplyModelAuthUpdate(context.Background(), base, late); err == nil {
+		t.Fatal("old discovery overwrote a later login")
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	current, ok := host.currentAuthManager().GetByID(base.ID)
+	if !ok || !reflect.DeepEqual(before, after) || current.Metadata["credential_generation"] != "login-two" || current.Metadata["model_snapshot"] != nil {
+		t.Fatal("obsolete discovery changed persisted or installed login")
+	}
+}
+
+func TestModelAuthUpdatePersistenceFailureDoesNotInstallSnapshot(t *testing.T) {
+	host, base, path := modelUpdateFixture(t)
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	updated := base.Clone()
+	updated.Metadata["model_snapshot"] = map[string]any{"models": []any{"unpersisted-model"}}
+	if _, err := host.ApplyModelAuthUpdate(context.Background(), base, updated); err == nil {
+		t.Fatal("removed credential was recreated by discovery")
+	}
+	current, ok := host.currentAuthManager().GetByID(base.ID)
+	if !ok || current.Metadata["model_snapshot"] != nil {
+		t.Fatal("failed persistence installed an unpersisted snapshot")
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("failed discovery changed the removed credential path")
+	}
+}
+
+func TestModelAuthUpdateHonorsCancelledDiscovery(t *testing.T) {
+	host, base, path := modelUpdateFixture(t)
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := host.ApplyModelAuthUpdate(ctx, base, base.Clone()); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled discovery error = %v", err)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		t.Fatal("cancelled discovery modified credentials")
+	}
+}
