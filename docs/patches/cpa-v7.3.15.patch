+func testWritePluginResponse(responsePtr uintptr, raw []byte) uintptr {
+	mem, err := windows.LocalAlloc(windows.LMEM_FIXED, uint32(len(raw)))
+	if err != nil || mem == 0 {
+		return 1
+	}
+	installed := false
+	defer func() {
+		if !installed {
+			_, _ = windows.LocalFree(windows.Handle(mem))
+		}
+	}()
+	var written uintptr
+	if err := windows.WriteProcessMemory(windows.CurrentProcess(), mem, &raw[0], uintptr(len(raw)), &written); err != nil || written != uintptr(len(raw)) {
+		return 1
+	}
+	response := windowsBuffer{ptr: mem, len: uintptr(len(raw))}
+	if err := windows.WriteProcessMemory(windows.CurrentProcess(), responsePtr, (*byte)(unsafe.Pointer(&response)), unsafe.Sizeof(response), &written); err != nil || written != unsafe.Sizeof(response) {
+		return 1
+	}
+	installed = true
 	return 0
 }
 
