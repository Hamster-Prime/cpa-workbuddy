+package auth
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// ApplyCredentialState projects an explicitly persisted, token-bound permanent
+// authentication failure onto the runtime record. Other metadata is ignored.
+func ApplyCredentialState(auth *Auth) bool {
+	reason, valid := boundCredentialFailure(auth)
+	if !valid {
+		return false
+	}
+	auth.Status = StatusError
+	auth.StatusMessage = "reauth_required"
+	auth.Unavailable = true
+	auth.LastError = &Error{Code: "reauth_required", Message: reason, HTTPStatus: http.StatusUnauthorized}
+	auth.NextRefreshAfter = time.Time{}
+	return true
+}
+
+func boundCredentialFailure(auth *Auth) (string, bool) {
+	if auth == nil {
+		return "", false
+	}
+	raw, exists := auth.Metadata["credential_state"]
+	if !exists || raw == nil {
+		return "", false
+	}
+	payload, err := json.Marshal(raw)
+	if err != nil {
+		return "", false
+	}
+	var state struct {
+		Version          int    `json:"version"`
+		Status           string `json:"status"`
+		Reason           string `json:"reason"`
+		CredentialDigest string `json:"credential_digest"`
+	}
+	if json.Unmarshal(payload, &state) != nil || state.Version != 1 || state.Status != "reauth_required" {
+		return "", false
+	}
+	switch state.Reason {
+	case "invalid_grant", "invalid_token", "revoked":
+	default:
+		return "", false
+	}
+	access, accessOK := auth.Metadata["access_token"].(string)
+	refresh, refreshOK := auth.Metadata["refresh_token"].(string)
+	if !accessOK && !refreshOK {
+		return "", false
+	}
+	tokens, err := json.Marshal([2]string{access, refresh})
+	if err != nil {
+		return "", false
+	}
+	digest := sha256.Sum256(tokens)
+	return state.Reason, state.CredentialDigest == hex.EncodeToString(digest[:])
+}
+
+func hasCredentialStateContract(auth *Auth) bool {
+	if auth == nil {
+		return false
+	}
+	state, exists := auth.Metadata["credential_state"]
+	if exists && state == nil {
+		return true
+	}
+	_, valid := boundCredentialFailure(auth)
+	return valid
+}
+
+// recoverCredentialState clears only authentication restrictions after an
+// explicit healthy login replaces the credentials. Quota and operator controls
+// remain authoritative, including while the credential is manually disabled.
+func recoverCredentialState(existing, auth *Auth, now time.Time) bool {
+	state, explicit := auth.Metadata["credential_state"]
+	if !explicit || state != nil || existing == nil || !CredentialsChanged(existing, auth) {
+		return false
+	}
+	changed := false
+	if auth.LastError != nil && (isUnauthorizedError(auth.LastError) || strings.EqualFold(auth.LastError.Code, "unauthorized") || auth.LastError.Code == "reauth_required") {
+		auth.LastError = nil
+		auth.StatusMessage = ""
+		changed = true
+		if !auth.Quota.Exceeded {
+			auth.Unavailable = false
+			auth.NextRetryAfter = time.Time{}
+			auth.Status = StatusActive
+		}
+	}
+	for _, state := range auth.ModelStates {
+		if state == nil || state.Status == StatusDisabled || state.LastError == nil || !(isUnauthorizedError(state.LastError) || strings.EqualFold(state.LastError.Code, "unauthorized") || state.LastError.Code == "reauth_required") {
+			continue
+		}
+		state.LastError = nil
+		state.StatusMessage = ""
+		state.UpdatedAt = now
+		if !state.Quota.Exceeded {
+			state.Unavailable = false
+			state.NextRetryAfter = time.Time{}
+			state.Status = StatusActive
+		}
+		changed = true
+	}
+	if auth.Disabled {
+		auth.Status = StatusDisabled
+	}
+	return changed
+}
